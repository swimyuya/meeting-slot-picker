{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "preserve",
    "rootDir": ".",
    "outDir": "../.api-build",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"],
  "exclude": ["__tests__/**"]
}
