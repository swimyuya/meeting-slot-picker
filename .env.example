# =============================================================================
# 日程ピッカー Pro 環境変数の例
# =============================================================================
# このファイルは安全 (秘密情報なし)。.env.local にコピーして実値を入れる。
# .env.local は .gitignore 済み (絶対にコミットしない)。

# -----------------------------------------------------------------------------
# Google OAuth クライアント
# -----------------------------------------------------------------------------
# GCP コンソールで Google Calendar API を有効化し、OAuth 同意画面に
# scope `calendar.readonly` `openid` `email` を設定すること。
#
# Tauri (デスクトップ) ビルドでは Desktop app タイプの client を使う。
# Web (PWA) / Chrome 拡張機能では Web application タイプの client を使う。
#
VITE_GOOGLE_CLIENT_ID=

# Tauri (デスクトップ) ビルドでのみ参照される。Web / 拡張機能の OAuth は
# サーバ (Vercel Function) 経由で client_secret を扱う設計なのでフロントの env には不要。
# 注意: VITE_* で始まる変数はビルドバンドルに焼き付くため、Web / 拡張のビルドでは
# 必ず未設定にすること。
VITE_GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Microsoft (Outlook) OAuth クライアント — Pro 版でのみ使う
# -----------------------------------------------------------------------------
# Azure ポータルでアプリ登録 (docs/azure-setup.md 参照)。
# tenant=common (個人 + 法人) で multi-tenant 構成。
#
VITE_MICROSOFT_CLIENT_ID=

# Tauri (デスクトップ) ビルドでのみ参照。Web / 拡張機能では使わない。
VITE_MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Web ビルドの API ベース URL (Chrome 拡張機能 / dev で必要)
# -----------------------------------------------------------------------------
# 同一オリジン (Vercel project 内の /api/*) を呼ぶ場合は空のままで OK。
# Chrome 拡張機能ビルドでは絶対 URL を必須に。
#   例: VITE_API_BASE_URL=https://meeting-slot-picker-pro.vercel.app
VITE_API_BASE_URL=

# =============================================================================
# Vercel サーバサイド env (Vercel ダッシュボードで設定、リポジトリには置かない)
# =============================================================================
# 以下は参考。.env.local には書かず、Vercel 側で設定する。
#
# GOOGLE_CLIENT_ID=...           (Web client の id、フロント env と同じ)
# GOOGLE_CLIENT_SECRET=...       (Web client の secret、サーバ側のみ)
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
#
# ALLOWED_ORIGIN=https://meeting-slot-picker-pro.vercel.app
#   ↑ CORS で許可する 1 つの origin (本番)
#
# ALLOWED_REDIRECT_URIS=https://meeting-slot-picker-pro.vercel.app/auth/callback
#   ↑ OAuth exchange で許可する redirect_uri (カンマ区切りで複数可)。
#     loopback http://127.0.0.1:PORT は別途自動許可される。
#
# EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
#   ↑ Chrome 拡張機能の id (32文字 a-p)。設定すると
#     `chrome-extension://<id>` と `https://<id>.chromiumapp.org/` が許可される。
