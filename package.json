{
  "name": "meeting-slot-picker-pro",
  "private": true,
  "version": "0.1.0",
  "description": "日程ピッカー Pro — Google + Outlook 対応の日程調整スロットピッカー",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:extension": "tsc -b && vite build --config vite.extension.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "preview": "vite preview",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "extension:icons": "node scripts/generate-extension-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@vercel/node": "^4.0.0",
    "idb": "^8.0.3",
    "node-ical": "^0.26.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdav": "^2.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "sinon-chrome": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
